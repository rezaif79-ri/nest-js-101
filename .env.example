# --- Application ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL (TypeORM) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rxzx_db
# Schema is managed by TypeORM migrations (npm run migration:run), not sync.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Redis (public catalog cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# TTL (seconds) for cached catalog list pages and product detail.
CACHE_TTL_SECONDS=60

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=ecommerce
MINIO_REGION=us-east-1
# Optional public/CDN base for serving objects; falls back to the endpoint.
MINIO_PUBLIC_URL=http://localhost:9000/ecommerce

# --- Payments ---
# Active gateway: 'mock' (offline, default) or 'midtrans' (sandbox).
PAYMENT_PROVIDER=mock
# Public base URL the mock gateway points its redirect/simulate link at.
APP_PUBLIC_URL=http://localhost:4001
# Shared secret the mock webhook expects in the X-Mock-Signature header.
MOCK_PAYMENT_SECRET=replace-with-a-mock-secret
# Midtrans sandbox credentials (only needed when PAYMENT_PROVIDER=midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
